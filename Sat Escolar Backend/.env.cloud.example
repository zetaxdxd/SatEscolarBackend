# Configuracion de la NUBE (Render / Neon / Supabase).
# Copia este archivo como  .env.cloud  y coloca la "External Database URL"
# del panel de Render. El archivo .env.cloud NO se sube a git.
#
# Sincronizar la nube hacia tu PostgreSQL local:
#   npm run db:sync
DATABASE_URL=postgresql://usuario:clave@host:5432/db?sslmode=require
PGSSL=true
