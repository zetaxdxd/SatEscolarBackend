# ─────────────────────────────────────────────────────────────
# MODO LOCAL (por defecto): usa PostgreSQL local con las variables PG*.
# MODO NUBE: define DATABASE_URL (tiene prioridad sobre PG*) y PGSSL=true.
# Sincronizar nube -> local:  npm run db:sync
# ─────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia_esto_por_una_clave_segura_2025

# LEGACY: SQLite ya no se usa (el sistema es 100% PostgreSQL)
#DB_PATH=./database/sat_escolar.db

# Nube (Render/Neon/Supabase). Si está definido, tiene prioridad.
#DATABASE_URL=postgresql://usuario:clave@host:5432/db?sslmode=require
#PGSSL=true

# PostgreSQL local
PGHOST=localhost
PGPORT=5432
PGDATABASE=sat_escolar
PGUSER=postgres
PGPASSWORD=coloca_tu_password_aqui
PGSSL=false

# Google Gemini API (para predicciones IA - tier gratuito: 1,500 req/día)
GEMINI_API_KEY=tu-clave-aqui

# Correo SMTP (códigos de verificación). ISO 27001: prohibido quemar
# credenciales en el código. Sin esto, el sistema opera en modo demo.
# Opción A: Gmail con contraseña de aplicación
#GMAIL_USER=colegio@gmail.com
#GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Opción B: proveedor SMTP genérico
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=usuario-smtp
#SMTP_PASSWORD=clave-smtp
#SMTP_FROM_EMAIL=colegio@gmail.com
# Respaldo opcional
#SMTP_HOST_RESPALDO=
#SMTP_PORT_RESPALDO=587
#SMTP_USER_RESPALDO=
#SMTP_PASSWORD_RESPALDO=
# API HTTP de Brevo (recomendado en la nube: no usa puertos SMTP).
# Se genera en Brevo → SMTP & API → API Keys (empieza con xkeysib-).
#BREVO_API_KEY=
